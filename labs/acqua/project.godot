; Engine configuration file.
; Laboratorio dell'acqua per Splash Lagoon (Godot 4.7, Forward+).

config_version=5

[application]

config/name="Lab Acqua (Splash Lagoon)"
config/description="Laboratorio separato per l'acqua: superficie, caustiche, sott'acqua, superfici bagnate, schizzi."
run/main_scene="res://demo/demo_piscina.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

WaterManager="*res://water/scripts/water_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/positional_shadow/atlas_size=4096
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
textures/default_filters/anisotropic_filtering_level=3

[shader_globals]

water_time={
"type": "float",
"value": 0.0
}
water_body_count={
"type": "int",
"value": 0
}
water_bodies_tex={
"type": "sampler2D",
"value": ""
}
water_caustics_tex={
"type": "sampler3D",
"value": "res://water/textures/caustics_3d.png"
}
water_noise_tex={
"type": "sampler2D",
"value": "res://water/textures/noise_rgba.png"
}
water_ripple_tex={
"type": "sampler2D",
"value": ""
}
water_ripple_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_drops_tex={
"type": "sampler2D",
"value": ""
}
water_drop_count={
"type": "int",
"value": 0
}
water_quality={
"type": "int",
"value": 2
}
water_glow_tex={
"type": "sampler2D",
"value": ""
}
water_glow_count={
"type": "int",
"value": 0
}
