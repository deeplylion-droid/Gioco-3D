[layer_names]

3d_render/layer_1="mondo"
3d_render/layer_2="viewmodel"
3d_render/layer_16="preparazione"
3d_physics/layer_1="mondo"
3d_physics/layer_2="giocatore"
3d_physics/layer_3="nemici"
3d_physics/layer_4="oggetti"
3d_physics/layer_5="interazione"
3d_physics/layer_6="bersagli_acqua"
3d_physics/layer_7="volumi_acqua"
3d_physics/layer_8="scale"
3d_physics/layer_9="barriere"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[editor_plugins]

enabled=PackedStringArray("res://addons/esportazione/plugin.cfg")

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.025, 1)
anti_aliasing/quality/screen_space_aa=2

[shader_globals]

water_time={
"type": "float",
"value": 0.0
}
water_body_count={
"type": "int",
"value": 0
}
water_bodies_tex={
"type": "sampler2D",
"value": ""
}
water_caustics_tex={
"type": "sampler3D",
"value": "res://addons/acqua/textures/caustics_3d.png"
}
water_noise_tex={
"type": "sampler2D",
"value": "res://addons/acqua/textures/noise_rgba.png"
}
water_ripple_tex={
"type": "sampler2D",
"value": ""
}
water_ripple_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_drops_tex={
"type": "sampler2D",
"value": ""
}
water_drop_count={
"type": "int",
"value": 0
}
water_quality={
"type": "int",
"value": 2
}
water_glow_tex={
"type": "sampler2D",
"value": ""
}
water_glow_count={
"type": "int",
"value": 0
}

[internationalization]

locale/translations=PackedStringArray("res://lingue/testi.it.translation", "res://lingue/testi.en.translation")
locale/fallback="it"
